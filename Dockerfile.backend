FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/pyproject.toml /app/backend/pyproject.toml
COPY backend/app /app/backend/app
COPY backend/run.py /app/backend/run.py
COPY backend/gunicorn.conf.py /app/backend/gunicorn.conf.py
COPY backend/dashboard /app/backend/dashboard

# Install project dependencies first (includes camel-oasis which pins neo4j==5.23.0)
# Then install graphiti-core without deps (it works fine with neo4j 5.23.0)
RUN pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir gunicorn \
  && pip install --no-cache-dir /app/backend \
  && pip install --no-cache-dir --no-deps 'graphiti-core>=0.28.0'

WORKDIR /app/backend
EXPOSE 5001
CMD ["gunicorn", "-c", "gunicorn.conf.py", "run:app"]
